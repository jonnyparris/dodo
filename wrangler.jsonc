{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dodo",
  "account_id": "4b430e167a301330d13a9bb42f3986a2",
  "main": "src/index.ts",
  "routes": [{ "pattern": "dodo.jonnyparris.club", "custom_domain": true }],
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "durable_objects": {
    "bindings": [
      { "name": "CODING_AGENT", "class_name": "CodingAgent" },
      { "name": "USER_CONTROL", "class_name": "UserControl" },
      { "name": "SHARED_INDEX", "class_name": "SharedIndex" },
      { "name": "CHAT_MONITOR", "class_name": "ChatMonitorAgent" }
    ]
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    {
      "binding": "OUTBOUND",
      "service": "dodo",
      "entrypoint": "AllowlistOutbound"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodingAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserControl", "SharedIndex"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["AppControl"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ExploreAgent", "TaskAgent"]
    },
    {
      // No-op tag — server already at v5. Future migrations should bump
      // from v6 onward.
      "tag": "v5"
    },
    {
      // The deployed worker has an `OutboundProxy` Durable Object class
      // registered (added by an out-of-band wrapper-Worker spike on the
      // codemode globalOutbound problem). The class is no longer in the
      // codebase, so we delete it here. Without this migration the
      // deploy fails with code 10064 (missing class).
      "tag": "v6",
      "deleted_classes": ["OutboundProxy"]
    },
    {
      // ChatMonitorAgent — PoC Google Chat monitor (DO with alarm loop).
      // See src/chat-monitor-agent.ts.
      "tag": "v7",
      "new_sqlite_classes": ["ChatMonitorAgent"]
    }
  ],
  "r2_buckets": [
    // Chat attachments (screenshots, uploaded images, model-generated images)
    // are stored in this bucket under the `attachments/` prefix. Run
    // `scripts/setup-attachment-lifecycle.sh` once per account to provision
    // the 30-day auto-expiry rule — lifecycle rules aren't yet configurable
    // from wrangler.jsonc, so they live out-of-band.
    { "binding": "WORKSPACE_BUCKET", "bucket_name": "dodo-workspaces" },
    // Fork snapshots — large opaque JSON blobs (often 5–10 MB once a
    // cloned repo's git pack files are base64-encoded) used by
    // forkSessionInternal to copy a workspace from one CodingAgent into
    // another. Previously stored as a single SQLite TEXT row in the
    // owner's UserControl DO, which trips SQLITE_TOOBIG above ~2 MB.
    // R2 has no relevant size cap at this scale and the snapshot is
    // already a one-shot intermediate (deleted after import), so a
    // dedicated bucket is the simplest fix.
    { "binding": "FORK_SNAPSHOTS", "bucket_name": "dodo-fork-snapshots" }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    // Required so `c.env.ASSETS.fetch(...)` works inside route handlers.
    // Without the binding declaration, `env.ASSETS` is undefined and any
    // page route that relies on the binding (e.g. /admin/seeds,
    // /admin/autopilot, /admin/chat-monitors) falls through to its
    // "Admin page not available" fallback.
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": ["ADMIN_EMAIL"]
  },
  "vars": {
    "DEFAULT_MODEL": "anthropic/claude-sonnet-4",
    // Default model used when a new session is created with activeGateway=ai-gateway.
    // Workers AI models (`@cf/…`) are only routable via AI Gateway.
    "AI_GATEWAY_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.6",
    // Built-in web_search tool (env.AI.websearch via AI Gateway). Admin-only,
    // billed per search to this gateway's account. Remove to disable.
    "WEB_SEARCH_GATEWAY_ID": "jp-gw",
    // linkup (ZDR, $5/1k) | ceramic (ZDR, $0.25/1k) | exa (no ZDR, $7/1k).
    // Ceramic returned spam/off-topic results on test queries (2026-10-13).
    "WEB_SEARCH_PROVIDER": "linkup",
    // Default Replicate image model for /generate and image editing. Per-user
    // overridable via the replicateImageModel config field. Requires the
    // REPLICATE_API_TOKEN secret to be set.
    "DEFAULT_REPLICATE_IMAGE_MODEL": "google/nano-banana-2",
    // Default model for the `explore` / `task` subagents.
    //
    // History: Kimi K2.6 (2026-04) never synthesised a summary as an
    // explore model; Haiku 4.5 replaced it. Haiku then turned out to be the
    // most expensive part of a run: on AI Gateway's /compat endpoint its
    // cache_control markers are stripped, so every call paid full input
    // price ($2.68 across 6 explore+bugfix bench runs, 0 cached tokens).
    //
    // DeepSeek V4.1 Flash 1017 on Workers AI, same 6 runs with only the
    // subagent model changed (2026-10-21): $0.35 for subagents (-87%),
    // 76% of subagent input tokens served from the prefix cache. Explore
    // answers were correct in 3/3 and bug fixes passed the hidden test in 3/3,
    // the same as with Haiku.
    // Caveat: Workers AI has a per-model requests-per-minute cap. Explore
    // fan-out hits 429 on ~25% of calls, which subagentMaxRetries() absorbs.
    // A session whose MAIN model is also 1017 shares that cap.
    //
    // Overrides: PUT /config exploreModel=..., or pass model=... per call.
    // @cf/* ids are wire-prefixed with workers-ai/ — see
    // resolveWireModelId in src/subagent-runner.ts.
    "DEFAULT_EXPLORE_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    // Default `task` subagent model. Same choice for the same reason.
    "DEFAULT_TASK_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "OPENCODE_BASE_URL": "https://opencode.cloudflare.dev/compat",
    // AI Gateway unified API base URL — include /{account_id}/{gateway_id}/compat
    // so the OpenAI-compatible SDK hits /chat/completions correctly.
    "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/4b430e167a301330d13a9bb42f3986a2/jp-gw/compat",
    // Local development default. Production must NOT rely on this: the
    // MCP OAuth callback host is derived from the live request origin
    // whenever WORKER_URL is unset or left at this loopback value
    // (see resolveMcpCallbackHost).
    "WORKER_URL": "http://localhost:8787",
    "DODO_VERSION": "0.4.0",
    // Worker script name used when querying Workers Observability for our
    // own logs (admin self-diagnose). Paired with CLOUDFLARE_ACCOUNT_ID
    // (var, below) and CLOUDFLARE_API_TOKEN (secret, set via
    // `wrangler secret put`) — without all three the cloudflare-logs
    // helpers return an empty result.
    "DODO_WORKER_NAME": "dodo",
    "CLOUDFLARE_ACCOUNT_ID": "4b430e167a301330d13a9bb42f3986a2"
  }
}
