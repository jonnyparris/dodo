{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dodo",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "durable_objects": {
    "bindings": [
      { "name": "CODING_AGENT", "class_name": "CodingAgent" },
      { "name": "USER_CONTROL", "class_name": "UserControl" },
      { "name": "SHARED_INDEX", "class_name": "SharedIndex" },
      { "name": "CHAT_MONITOR", "class_name": "ChatMonitorAgent" }
    ]
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    {
      "binding": "OUTBOUND",
      "service": "dodo",
      "entrypoint": "AllowlistOutbound"
    }
  ],
  // Test environment only needs the class creation migrations.
  // The v3 "deleted_classes" migration for AppControl is a production
  // deployment concern — vitest-pool-workers chokes on deleting a class
  // that was never declared in the test bindings.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodingAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserControl", "SharedIndex"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ExploreAgent", "TaskAgent"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["ChatMonitorAgent"]
    }
  ],
  "r2_buckets": [
    { "binding": "WORKSPACE_BUCKET", "bucket_name": "dodo-workspaces" },
    { "binding": "FORK_SNAPSHOTS", "bucket_name": "dodo-fork-snapshots" }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./public",
    // Required so `c.env.ASSETS.fetch(...)` works inside route handlers.
    "binding": "ASSETS"
  }
  // The `ai` and `artifacts` bindings from wrangler.jsonc are intentionally
  // omitted: vitest-pool-workers starts a remote proxy session for them and
  // fails without CLOUDFLARE_API_TOKEN, so declaring them would break
  // `npm test` in CI. Tests stub these bindings directly instead (see
  // test/dodo.test.ts and test/artifacts-route-unit.test.ts).
}
